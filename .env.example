# YatraSense — public Vite vars + server placeholders only.
# Copy to `.env` (gitignored). Never put secrets in VITE_* variables.

# Frontend → backend. Vite proxies /api to :8787 in local dev.
VITE_API_URL=http://localhost:8787

# Server-only LLM. Never prefix with VITE_.
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# OpenAI-compatible chat completions URL (OpenRouter default).
# AI_API_URL=https://openrouter.ai/api/v1/chat/completions

# Production CORS. Comma-separated frontend origins.
# FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Optional map/hotel photo keys (server only).
# GOOGLE_PLACES_KEY=
# GOOGLE_MAPS_API_KEY=
# MAPBOX_TOKEN=
# MAPTILER_KEY=
