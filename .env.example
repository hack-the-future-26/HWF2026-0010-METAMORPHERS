# YatraSense — public Vite env vars only
# Never put Gemini/OpenAI/database secrets in VITE_* variables.
# Those belong on a backend. The React app only talks to VITE_AI_API_URL.

# Open-Meteo (no key required)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Photon geocoding (preferred). No key required.
VITE_PHOTON_URL=https://photon.komoot.io/api/

# Nominatim fallback geocoding. No key required. Optional self-host override.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org

# Overpass OSM places. No key required. Optional self-host / mirror.
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
VITE_PLACES_API_URL=https://overpass-api.de/api/interpreter

# OSRM routing. No key required. Optional self-host override.
VITE_OSRM_URL=https://router.project-osrm.org
VITE_ROUTING_API_URL=https://router.project-osrm.org

# Optional OSM/Carto tile template
VITE_MAPS_TILE_URL=

# Backend AI endpoint (React → your server → Gemini/OpenAI).
# POST JSON { prompt, context }. Response: { reply } or OpenAI-style choices.
# Leave empty to use the built-in rule-based planner / assistant.
VITE_AI_API_URL=
VITE_AI_MODEL=

# Optional live feeds. Leave empty unless you actually have these APIs.
# Do not present mock traffic/crowd as real-time data.
VITE_EVENTS_API_URL=
VITE_CROWD_API_URL=

# Unused by the frontend — do not put secret keys here.
# VITE_WEATHER_API_KEY=
# VITE_GEOCODING_API_KEY=
# VITE_PLACES_API_KEY=
# VITE_ROUTING_API_KEY=
# VITE_EVENTS_API_KEY=
# VITE_CROWD_API_KEY=
# VITE_AI_API_KEY=
